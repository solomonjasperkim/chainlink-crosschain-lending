# Deployer key for `forge script --broadcast`. Never commit a real .env file — it's gitignored.
PRIVATE_KEY=

# RPC endpoint for the chain you're deploying to.
RPC_URL_A=

# --- Current addresses: pull these fresh before deploying, see README.md#deploying-to-testnets ---
COLLATERAL_TOKEN=
DEBT_TOKEN=
COLLATERAL_PRICE_FEED=
DEBT_PRICE_FEED=
CCIP_ROUTER=
LINK_TOKEN=

# Optional, defaults to 3600 (1 hour) if unset.
PRICE_STALENESS_SECONDS=3600
